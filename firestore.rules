rules_version = '2';

// UnZA z CHAT — Firestore security rules.
// Principle: authenticated users can READ profiles/feed/public content, but can
// only WRITE their own data (or content they're a member/author of).
// Deploy with:  firebase deploy --only firestore:rules
// Test first against the emulator:  firebase emulators:start --only firestore

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function roleOf() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // For likes/reposts/reply-counts: allow non-authors to change ONLY these fields.
    function onlyEngagementChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['likes', 'likedBy', 'reposts', 'repostedBy', 'replies']);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn();                 // profiles, chat names, ZFeed authors
      allow create, update, delete: if isSelf(uid);

      // Social graph — readable by anyone signed in (follow counts on profiles).
      match /followers/{fid} {
        allow read: if signedIn();
        allow write: if isSelf(uid) || isSelf(fid);
      }
      match /following/{tid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
      // Everything else under a user is private to that user.
      match /{sub}/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ── Chats ────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      function members() { return resource.data.members; }
      // GET on a missing chat must be allowed — otherwise getOrCreateChat's
      // existence check returns permission-denied and New Chat can't open
      // 1:1 threads with people already on ZCHAT (invite-only path still worked).
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/chats/$(chatId)) ||
        request.auth.uid in resource.data.members
      );
      allow list: if signedIn() && request.auth.uid in members();
      allow update, delete: if signedIn() && request.auth.uid in members();
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      // Self-join via invite link: a non-member may add ONLY themselves, and only
      // to the membership fields (never touching other members' data).
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberUids', 'memberNames', 'unreadCount', 'archived']) &&
        request.auth.uid in request.resource.data.members &&
        !(request.auth.uid in resource.data.members);

      match /messages/{msgId} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read, create, update, delete: if signedIn() && request.auth.uid in chatMembers();
      }
      match /typing/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
      // Join requests (approval mode): a user creates/removes their own request;
      // group members (admins) can read and remove any.
      match /joinRequests/{uid} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read:   if signedIn() && (isSelf(uid) || request.auth.uid in chatMembers());
        allow create: if isSelf(uid);
        allow delete: if signedIn() && (isSelf(uid) || request.auth.uid in chatMembers());
      }
    }

    // ── Calls (signalling) ───────────────────────────────────────────────────
    match /calls/{callId} {
      allow read, create, update: if signedIn();
    }

    // ── Status (24h) ─────────────────────────────────────────────────────────
    match /statuses/{ownerUid} {
      allow read: if signedIn();
      allow write: if isSelf(ownerUid);
      match /items/{itemId} {
        allow read: if signedIn();
        allow create, delete: if isSelf(ownerUid);
        allow update: if signedIn();            // viewedBy updates by viewers
      }
    }

    // ── ZFeed (threads) ──────────────────────────────────────────────────────
    match /threads/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.authorUid == request.auth.uid || onlyEngagementChanged());
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow update: if signedIn();            // reply likes
        allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }
    }

    // ── Broadcasts ───────────────────────────────────────────────────────────
    match /broadcasts/{channelId} {
      allow read: if signedIn();
      // Creator must own the channel they create.
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
      // Admin: full control (rename, delete, post lastMessage preview).
      allow update, delete: if signedIn() && resource.data.adminUid == request.auth.uid;
      // Anyone signed in may (un)subscribe — but ONLY the subscribers field may change.
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscribers']);
      match /messages/{msgId} {
        allow read: if signedIn();
        // Only the channel admin can broadcast a message.
        allow create: if signedIn() &&
          get(/databases/$(database)/documents/broadcasts/$(channelId)).data.adminUid == request.auth.uid;
      }
    }

    // ── Communities ──────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if signedIn();
      // Creator must own the community they create.
      allow create: if signedIn() && request.auth.uid in request.resource.data.adminUids;
      // Admins have full control.
      allow update, delete: if signedIn() && request.auth.uid in resource.data.adminUids;
      // Anyone signed in may join/leave — but ONLY the membership fields may change.
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'adminUids']);
    }

    // ── Courses (virtual classroom) ──────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if signedIn() && roleOf() == 'lecturer';
      match /{sub}/{docId} {
        allow read: if signedIn();
        allow write: if signedIn() && roleOf() == 'lecturer';
      }
    }

    // ── Reports (moderation) — write-only from clients ───────────────────────
    match /reports/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;     // review via console/admin only
    }

    // ── Papers (if mirrored to Firestore) ────────────────────────────────────
    match /papers/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      // Only lecturers can verify/unverify or delete a paper.
      allow update, delete: if signedIn() && roleOf() == 'lecturer';
      // Any signed-in student may bump the download counter — and ONLY that field.
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']);
    }

    // Everything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
